#pragma once

#include <qapplication.h>
#include <qdatetime.h>
#include <qstandardpaths.h>
#include <qstring.h>

#define APP_ORGANIZATION        "@APP_ORGANIZATION@"
#define APP_ORGANIZATION_DOMAIN "@APP_ORGANIZATION_DOMAIN@"
#define APP_TITLE               "@APP_TITLE@"
#define APP_VERSION             "@APP_VERSION@"
#define APP_COPYRIGHT_TEXT      "@APP_COPYRIGHT_TEXT@"
#define APP_UUID                "@APP_UUID@"

#define APP_LANG_FILEPATH       "languages/languages.json"
#define APP_LOCK_FILEPATH       (APP_TITLE "-" APP_UUID ".lock")

// Log Files
#define APP_LOG_DIRPATH         (QStandardPaths::writableLocation(QStandardPaths::AppDataLocation))
#define APP_LOG_FILENAME        (QDate::currentDate().toString("yyyy-MM-dd") + ".log")
#define APP_LOG_FILEPATH        (APP_LOG_DIRPATH + "/" + APP_LOG_FILENAME)

#define APP_DIRPATH QApplication::applicationDirPath()
#ifdef Q_OS_MAC
    #define APP_RESOURCE_DIRPATH    (APP_DIRPATH + "/../Resources")
#else
    #define APP_RESOURCE_DIRPATH    APP_DIRPATH
#endif // Q_OS_MAC

// Windows
#define COMMAND_DISPLAY_NAME        "CMD"
#define POWER_SHELL_DISPLAY_NAME    "Power Shell"
#define COMMAND_EXE                 "C:/Windows/System32/cmd.exe"
#define POWER_SHELL_EXE             "C:/Windows/System32/WindowsPowerShell/v1.0/powershell.exe"

// MacOS
#define TERMINAL_DISPLAY_NAME      "Terminal"
#define TERMINAL_EXE               "/bin/zsh"

#ifdef Q_OS_WIN
    #define DEFAULT_HOTKEY             "Alt+T"
#else
    #define DEFAULT_HOTKEY             "Win+Alt+T"
#endif // Q_OS_WIN
